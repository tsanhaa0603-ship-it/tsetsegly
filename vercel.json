{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.tsetsegly.mn" }],
      "destination": "https://tsetsegly.mn/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/gift/(.*)", "destination": "/gift/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
